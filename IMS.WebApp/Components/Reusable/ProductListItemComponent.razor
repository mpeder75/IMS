@inject NavigationManager NavigationManager
@inject IDeleteProductUseCase DeleteProductUseCase

@if (Product is not null)
{
    <tr>
        <td>@Product.ProductName</td>
        <td>@Product.Quantity</td>
        <td>@Product.Price.ToString("C")</td>
        <td>
            <button
                type="button"
                class="btn btn-light"
                @onclick="async () => { await HandleEdit(Product.ProductId); }">
                Edit
            </button>
        </td>
        <td>
            <button
                type="button"
                class="btn btn-light"
                @onclick="async () => { await HandleDelete(Product.ProductId); }">
                Delete
            </button>
        </td>
    </tr>
}

@code {

    [Parameter]
    public Product? Product { get; set; }

    private async Task HandleDelete(int productId)
    {
        await DeleteProductUseCase.ExecuteAsync(productId);
        Product = null;
    }

    private async Task HandleEdit(int productId)
    {
        NavigationManager.NavigateTo($"/editproduct/{productId}");
    }
}